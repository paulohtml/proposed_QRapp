{
  "expo": {
    "name": "QR Attendance",
    "slug": "qrappmagbanua",
    "owner": "cctc-ccs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qr-attendance",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cctcccs.qrappmagbanua"
    },
    "android": {
      "package": "com.cctcccs.qrappmagbanua",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QR Attendance to use the camera to scan event QR codes."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "596dc5fa-2e3a-47cb-b9cd-09dfcea239d3"
      }
    }
  }
}